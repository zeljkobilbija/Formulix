<?xml version="1.0" encoding="utf-8"?>
<!-- Jedna kartica oblasti: kvadratna, u boji oblasti -->
<com.zeljkobilbija001.formulix.KvadratnaKartica xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/kartica"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/kartica_pritisak"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:rippleColor="#33FFFFFF"
    app:strokeWidth="0dp"
    tools:cardBackgroundColor="@color/planimetrija">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/simbol"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold"
            tools:text="△" />

        <ImageView
            android:id="@+id/simbolSlika"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/naziv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Planimetrija" />

        <TextView
            android:id="@+id/opis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.9"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:text="Obim i površina" />
    </LinearLayout>
</com.zeljkobilbija001.formulix.KvadratnaKartica>
