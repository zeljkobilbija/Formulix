<?xml version="1.0" encoding="utf-8"?>
<!-- Stavka u mreži od dve kolone: pastelni krug sa simbolom, ispod naziv i opis -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="10dp">

    <com.zeljkobilbija001.formulix.KrugView
        android:id="@+id/simbolPozadina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/krug_talas">

        <TextView
            android:id="@+id/simbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:textSize="34sp"
            android:textStyle="bold"
            tools:text="%" />

        <ImageView
            android:id="@+id/simbolSlika"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </com.zeljkobilbija001.formulix.KrugView>

    <TextView
        android:id="@+id/naziv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_horizontal"
        android:lineSpacingMultiplier="0.95"
        android:maxLines="2"
        android:textColor="@color/tekst"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Procenti" />

    <TextView
        android:id="@+id/opis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textColor="@color/tekst_sekundarni"
        android:textSize="13sp"
        tools:text="Procenat, osnovica" />
</LinearLayout>
