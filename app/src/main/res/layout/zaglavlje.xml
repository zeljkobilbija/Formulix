<?xml version="1.0" encoding="utf-8"?>
<!-- Obojeno zaglavlje: dugme nazad, naslov i podnaslov (boja se postavlja iz koda) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/zaglavlje"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <ImageButton
        android:id="@+id/nazad"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/nazad"
        android:src="@drawable/ic_nazad" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/naslov"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/podnaslov"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.92"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/dugmePodeli"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="-10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/podeli"
        android:src="@drawable/ic_podeli" />
</LinearLayout>
