<?xml version="1.0" encoding="utf-8"?>
<!-- Početni ekran: topli stakleni dizajn sa mehurićima oblasti (pozadina: ToplaPozadina) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#5A3A2A"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Naslov, dugme Podeli i dugme za privatnost -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:text="@string/app_name"
                android:textColor="@color/topla_tekst"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/podnaslov"
                android:textColor="@color/topla_tekst_2"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Vidljivo samo kada je potrebno (npr. korisnici u EU) -->
        <ImageButton
            android:id="@+id/dugmePrivatnosti"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/dugme_staklo"
            android:contentDescription="@string/privatnost"
            android:src="@drawable/ic_privatnost"
            android:tint="@color/topla_tekst"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/dugmePodeli"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/dugme_staklo"
            android:contentDescription="@string/podeli"
            android:src="@drawable/ic_podeli"
            android:tint="@color/topla_tekst" />
    </LinearLayout>

    <!-- Pretraga: stakleno polje -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/polje_staklo"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_pretraga"
            app:tint="@color/topla_tekst_2" />

        <EditText
            android:id="@+id/pretraga"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@null"
            android:hint="@string/pretraga_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/topla_tekst"
            android:textColorHint="@color/topla_tekst_2"
            android:textCursorDrawable="@null"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/obrisiPretragu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/obrisi_pretragu"
            android:src="@drawable/ic_obrisi"
            android:tint="@color/topla_tekst"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/naslovOblasti"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="@string/rezultati"
        android:textAllCaps="true"
        android:textColor="@color/topla_tekst_2"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Mehurići oblasti -->
    <com.zeljkobilbija001.formulix.KrugoviLayout
        android:id="@+id/krugovi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:layoutAnimation="@anim/layout_ulaz" />

    <!-- Rezultati pretrage (teme iz svih oblasti) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaRezultata"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/nemaRezultata"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:paddingTop="40dp"
        android:text="@string/nema_rezultata"
        android:textColor="@color/topla_tekst_2"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- AdMob baner (Reklame.prikaziBaner), visina 70 dp -->
    <FrameLayout
        android:id="@+id/reklamaKontejner"
        android:layout_width="match_parent"
        android:layout_height="70dp" />

</LinearLayout>
